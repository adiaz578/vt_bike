prefix : [10168]
prefix = 

// KeyGen Function: 
// - Input: (h0, h1) this is generated in runKat.c utilizing the pseudo-random number generator.
// - Output: (pk, sk) which are the dense public key and sparse private key respectively. 
keyGen : (GF, GF) -> ([20336], [20336])

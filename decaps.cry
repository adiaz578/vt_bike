//
//     Encapsulation Function: 
//
//     - Input: the sparse private key (h0, h1) and the cryptogram c.
//     - Output: the decapsulated key K.


// Size constants
// bit_size = 1271
// r_bits   = 10163

import GF2_10163

// decryption function returns the syndrome
decrypt : (GF, GF, [20336]) -> GF
decrypt (h0, h1, c_full) = s
    where
        // trim the ciphertext since we are using BIKE2
        c = take c_full : GF

        // 1. Compute the syndrome s ← ch0
        s = mult c h0
